# copy to .env and change the password
POSTGRES_DB=bom
POSTGRES_USER=bom
POSTGRES_PASSWORD=change-me
APP_PORT=8080

# Material Temp Number settings
#   plant      -> separate running sequence per planning plant (Dukhan has its own)
#   plant_type -> one sequence for Dukhan, one shared by all other plants
NUMBERING_SCOPE=plant
EQUIPMENT_START=40001
SPARE_START=500001
# true -> cabinets with the same spares in other quantities get their own SUBMT / BOM (false = old rule)
CABINET_COMPARE_QUANTITIES=true

# Sign-in cookie: set to true when the app is served over HTTPS
COOKIE_SECURE=false
